@using Glazor.Misc

@namespace Glazor.Grds

@inject IJSRuntime JS
@inject ILogger<TouchScroller> Logger
@implements IAsyncDisposable 

@code {
    /// <summary>Required. Raised with the columns and rows to scroll by.</summary>
    [Parameter, EditorRequired]
    public EventCallback<ScrollByEvent> OnScrollBy { get; set; }

    /// <summary>Required. The element the fingers move on.</summary>
    [Parameter, EditorRequired]
    public ElementReference ScrollableRef { get; set; }

    /// <summary>Required. The rows shown, which the finger's move is measured in.</summary>
    [Parameter, EditorRequired]
    public int PageSize { get; set; }

    /// <summary>How many fingers a scrolling gesture takes.</summary>
    public enum FingerCount {
        /// <summary>One finger.</summary>
        One = 1,
        /// <summary>Two fingers.</summary>
        Two = 2
    }

    /// <summary>How many fingers scroll; with two, one finger keeps its touch selection.</summary>
    [Parameter]
    public FingerCount Fingers { get; set; } = FingerCount.Two;

    /// <summary>Turns the scrolling off without unmounting it.</summary>
    [Parameter]
    public bool Enabled { get; set; } = true;

    private IJSObjectReference? module;
    // https://learn.microsoft.com/en-us/aspnet/core/blazor/javascript-interoperability/call-dotnet-from-javascript?view=aspnetcore-10.0
    private DotNetObjectReference<TouchScroller>? dotNetObjRef;
    private ElementReference _lastScrollableRef;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        dotNetObjRef = DotNetObjectReference.Create(this);
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && module == null)
        {
            // https://learn.microsoft.com/en-us/aspnet/core/blazor/components/class-libraries?view=aspnetcore-10.0&tabs=visual-studio
            IJSObjectReference imported = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/Glazor/Grds/TouchScroller.razor.js");
            if (_disposed)
            {
                await imported.DisposeAsync();   // disposed while the import was in flight
                return;
            }
            module = imported;
        }
        // It's not enough on firstRender and sometimes firstRender and !firstRender are executed "together"
        if (module != null && !string.IsNullOrEmpty(ScrollableRef.Id))
        {
            // must be execute every time to update the scroller
            ElementReference previous = _lastScrollableRef;
            _lastScrollableRef = ScrollableRef;
            try {
                if (!string.IsNullOrEmpty(previous.Id) && previous.Id != ScrollableRef.Id)
                    await module.InvokeVoidAsync("cleanup", previous);   // or a drag on it keeps scrolling the grid
                await module.RequireNotNull().InvokeVoidAsync("registerScrollerCallback", ScrollableRef, dotNetObjRef.RequireNotNull(),
                        nameof(ProcessScrollBy), PageSize, Fingers, Enabled);
            }
            catch (JSException e)
            {
                Logger.LogError(e, $"TouchScroller not registered");
            }
            catch (ObjectDisposedException e)
            {
                if (Logger.IsEnabled(LogLevel.Trace))
                    Logger.LogTrace("As far as I know this can be safely ignored: {msg}", e.Message);
            }
        }
    }

    private async ValueTask CleanupAsync()
    {
        if (!string.IsNullOrEmpty(_lastScrollableRef.Id))   // the element registered, which the parameter may have left
        {
            await module!.InvokeVoidAsync("cleanup", _lastScrollableRef);
        }
    }

    private bool _disposed;

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _disposed = true;
        if (module != null)
        {
            try
            {
                try
                {
                    await CleanupAsync();
                }
                finally
                {
                    await module.DisposeAsync();
                }
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
            {
                // Ignore
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error while disposing TouchScroller");
            }
            module = null;
        }
        dotNetObjRef?.Dispose();
        GC.SuppressFinalize(this);
    }

    /// <summary>Called by the JS side when the fingers move.</summary>
    [JSInvokable, System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]   // for the JS side, not for hosts
    public async Task ProcessScrollBy(int dx, int dy)
    {
        try
        {
            // Any script on the page can call this: a move the height of the element gives 3 pages at most, a swipe one column
            await OnScrollBy.InvokeAsync(new ScrollByEvent(Math.Clamp(dx, -1, 1), Math.Clamp(dy, -3 * PageSize, 3 * PageSize)));
        }
        catch (Exception ex) when (!_disposed)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    /// <summary>A move of the fingers, in the grid's units.</summary>
    /// <param name="Dx">The columns to scroll by, one at most either way.</param>
    /// <param name="Dy">The rows to scroll by, at most three pages either way.</param>
    public record ScrollByEvent(int Dx, int Dy);
}
