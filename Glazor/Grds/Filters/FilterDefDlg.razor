@namespace Glazor.Grds.Filters

@using Glazor.Misc

<DialogBox @ref="jsDialog" Class="glazor filterDefDlg" aria-labelledby="@(title != null ? _titleId : null)">
    <div class="content">
        @if (title != null) {
            <h3 class="title" id="@_titleId">@title</h3>
        }
        @if (filterDef != null) {
            Dictionary<string, object> @params = new() { { "FilterDef", filterDef }, { "NullableValue", _nullableValue }, { "DialogClosedToken", _closing.Token } };
            <DynamicComponent @ref="dynamicComponent" Type="@filterDef.Renderer().RendererType" Parameters="@(@params)"></DynamicComponent>
        }
        <div style="margin-top: 10px; display: flex; justify-content: center;" class="buttons">
            @* Enter on Cancel and Clear is taken there, before the content's Enter runs OK *@
            <button style="margin-right: 1em;" type="button" @onclick="CloseAsync" class="cancel">@Texts.Get(TextKeys.Cancel)<KeyAction Key="Enter" OnKey="@(evt => CloseAsync())"/></button>
            <button @ref="okButton" type="button" @onclick="SubmitAsync" class="ok">@Texts.Get(TextKeys.OK)</button>
            <button type="button" @onclick="ClearAsync" class="clear">@Texts.Get(TextKeys.Clear)<KeyAction Key="Enter" OnKey="@(evt => ClearAsync())"/></button>
        </div>
        <KeyAction Key="Enter" OnKey="@(evt => SubmitAsync())" BindAncestorWithTag="div"/>
        @* taken on the dialog, so a host's own Escape around the grid does not see it *@
        <KeyAction Key="Escape" OnKey="@(evt => CloseAsync())" BindAncestorWithTag="dialog"/>
    </div>
</DialogBox>

