@namespace Glazor.Grds.Filters

@using Glazor.Grds.Mdls
@using Glazor.Misc
@using Microsoft.AspNetCore.Components.Forms

@typeparam SELF where SELF : ADynaSetDef<SELF, VT, RT, KT>
@typeparam VT
@typeparam RT where RT : class
@typeparam KT
@inherits AFilterDefRenderer<SELF>

<div style="width:500px;">
    <table>
    @if (NullableValue) {
    <tr>
        <td><label for="@($"{IdPrefix}_include")">@Texts.Get(TextKeys.IncludeNull): </label></td>
        <td><InputCheckbox id="@($"{IdPrefix}_include")" @bind-Value="FilterDef.IncludeNull"/></td>
        <td width="50%"></td>
    </tr>
    }
    <tr>
        <td colspan="3">
            <MultiSelGrid @ref="gridRef" Model="Model" SelectionModel="SelectionModel">
            </MultiSelGrid>
        </td>
    </tr>
    </table>
</div>

@code {
    private MultiSelGrid<RT> gridRef = null!;

    private DataGridModel<RT>? _model;
    /// <summary>The rows offered, which the dialog lists.</summary>
    public DataGridModel<RT> Model { 
        get => _model.RequireNotNull();
    }

    private ADynaSetDef<SELF, VT, RT, KT>? _lastFilterDef;
    private CancellationToken _lastDialogClosedToken;

    private ISelectionModel<RT> _selectionModel = new SetSelectionModel<RT>();
    /// <summary>The rows chosen.</summary>
    public ISelectionModel<RT> SelectionModel { 
        get => _selectionModel.RequireNotNull();
    }

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!Object.ReferenceEquals(_lastFilterDef, FilterDef) || _lastDialogClosedToken != DialogClosedToken)   // read again on each opening
        {
            _lastFilterDef = FilterDef;
            _lastDialogClosedToken = DialogClosedToken;
            _model = FilterDef.CreateAllValuesModel_(Texts);
            _model.RequireNotNull().GetData().Set(await FilterDef.PopulateAsync(DialogClosedToken));
            _selectionModel = FilterDef.CreateSetSelectionModel();
        }
    }

    /// <inheritdoc/>
    protected internal override async ValueTask ShownAsync()
    {
        if (gridRef != null)
            await gridRef.FocusAsync();
    }
}
